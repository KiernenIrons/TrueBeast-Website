+
+// ── Announcement Drafts (approval queue) ──────────────────────────────────────
+// Collection: `announceDrafts` (Firestore, same public-write pattern as `discordCards`).
+// Any code — this bot, the website admin dashboard, or a future webhook — can queue a
+// draft by creating a doc with status: 'pending' and a `promptText` describing what the
+// announcement should say. This bot drafts the copy with Claude, posts a preview with
+// Approve / Request Changes / Discard buttons to #testing, and only posts to the real
+// target channel once approved. "Request Changes" opens a modal — whatever's typed there
+// is sent back to Claude along with the current draft to produce a revision, looping
+// until approved or discarded.
+//
+// Doc shape (all fields are strings unless noted):
+//   status            'pending' | 'awaiting_approval' | 'posted' | 'rejected' | 'failed'
+//   source            'manual' | 'event' | 'schedule'
+//   sourceDetail      human-readable description of what triggered this draft
+//   promptText        what the announcement should be about (used for the first draft)
+//   title / bodyText  drafted copy (set once Claude has drafted it)
+//   targetChannelId   channel to post the final announcement to
+//   requestedBy       Discord user ID, or 'website' / 'schedule'
+//   testingMessageId  message ID of the preview in #testing
+//   postedMessageId   message ID of the final announcement, once posted
+//   historyJson       JSON array of { role, text, ts, by } — change-request log
+//   createdAt / updatedAt  ISO timestamps
+//
+// To queue a draft from outside the bot (e.g. a site event), create a doc at
+// announceDrafts/<id> with: { id, status: 'pending', source: 'event', sourceDetail,
+// promptText, targetChannelId, requestedBy, historyJson: '[]', createdAt, updatedAt }.
+// This bot's 20s poll picks it up from there.
+
+const processedAnnounceDraftIds = new Set();
+
+async function firestoreRunQuery(collectionId, whereField, whereValue, limit = 10) {
+    const url = `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT}/databases/(default)/documents:runQuery?key=${FIREBASE_API_KEY}`;
+    const res = await fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ structuredQuery: {
+            from: [{ collectionId }],
+            where: { fieldFilter: { field: { fieldPath: whereField }, op: 'EQUAL', value: { stringValue: whereValue } } },
+            limit,
+        }}),
+    });
+    if (!res.ok) throw new Error(`Firestore query on ${collectionId} failed: HTTP ${res.status}`);
+    const rows = await res.json();
+    return rows.map(r => r.document).filter(Boolean);
+}
+
+function decodeFirestoreFields(fields) {
+    const out = {};
+    for (const [k, v] of Object.entries(fields || {})) {
+        out[k] = v.integerValue !== undefined ? Number(v.integerValue) : (v.stringValue ?? '');
+    }
+    return out;
+}
+
+async function getAnnounceDraft(id) {
+    return firestoreGet('announceDrafts', id);
+}
+
+async function saveAnnounceDraft(id, fields) {
+    // firestoreSet PATCHes the whole doc with no update mask — always pass every field,
+    // and strip undefined/null so we never write the literal string "undefined".
+    const clean = {};
+    for (const [k, v] of Object.entries(fields)) if (v !== undefined && v !== null) clean[k] = v;
+    return firestoreSet('announceDrafts', id, clean);
+}
+
+function buildAnnouncePayload(title, body, { accentColor = 0x5865f2 } = {}) {
+    const content = title ? `## ${title}\n\n${body || ''}` : (body || '');
+    return {
+        flags: 32768, // IS_COMPONENTS_V2
+        components: [
+            { type: 17, accent_color: accentColor, components: [ { type: 10, content } ] },
+        ],
+    };
+}
+
+function buildAnnouncePreviewPayload(draft) {
+    const header = {
+        type: 17,
+        accent_color: 0xf4c430,
+        components: [ { type: 10, content:
+            `📋 **DRAFT — awaiting approval**\n` +
+            `**Source:** ${draft.sourceDetail || draft.source}\n` +
+            `**Target:** <#${draft.targetChannelId}>` } ],
+    };
+    const preview = {
+        type: 17, accent_color: 0x5865f2,
+        components: [ { type: 10, content: draft.title ? `## ${draft.title}\n\n${draft.bodyText || ''}` : (draft.bodyText || '_(empty)_') } ],
+    };
+    const buttons = { type: 1, components: [
+        { type: 2, style: 3, label: '✅ Approve & Post', custom_id: `annapprove:${draft.id}` },
+        { type: 2, style: 2, label: '✏️ Request Changes', custom_id: `annedit:${draft.id}` },
+        { type: 2, style: 4, label: '🗑️ Discard', custom_id: `annreject:${draft.id}` },
+    ]};
+    return { flags: 32768, components: [ header, preview, buttons ] };
+}
+
+async function draftAnnouncementText({ promptText, priorTitle, priorBody, changeRequest }) {
+    const system = `You write Discord announcement copy for TrueBeast, a gaming community server. Voice: punchy, upbeat, a little playful — never corporate. Use Discord markdown (bold with **, bullet lists with -, sparing emoji). Keep it tight: a short title and a body of 1-4 short paragraphs or a short bullet list.
+Return ONLY in this exact format, nothing else:
+TITLE: <title text, no markdown>
+BODY:
+<body text, markdown allowed>`;
+
+    const userParts = [];
+    if (priorBody) {
+        userParts.push(`Current draft:\nTITLE: ${priorTitle || ''}\nBODY:\n${priorBody}`);
+        userParts.push(`Requested change: ${changeRequest}`);
+    } else {
+        userParts.push(`Write an announcement about: ${promptText}`);
+    }
+
+    const res = await fetch('https://api.anthropic.com/v1/messages', {
+        method: 'POST',
+        headers: {
+            'x-api-key': ANTHROPIC_API_KEY,
+            'anthropic-version': '2023-06-01',
+            'content-type': 'application/json',
+        },
+        body: JSON.stringify({
+            model: 'claude-haiku-4-5-20251001',
+            max_tokens: 500,
+            system,
+            messages: [{ role: 'user', content: userParts.join('\n\n') }],
+        }),
+    });
+    if (!res.ok) throw new Error(`Anthropic API error: HTTP ${res.status}`);
+    const data = await res.json();
+    const text = data.content?.[0]?.text?.trim() || '';
+    const m = text.match(/TITLE:\s*(.*?)\s*BODY:\s*([\s\S]*)/i);
+    if (!m) return { title: priorTitle || 'Announcement', body: text || priorBody || '' };
+    return { title: m[1].trim(), body: m[2].trim() };
+}
+
+async function postAnnounceDraftPreview(draft) {
+    const payload = buildAnnouncePreviewPayload(draft);
+    const res = await fetch(`https://discord.com/api/v10/channels/${ANNOUNCE_TESTING_CHANNEL_ID}/messages`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bot ${TOKEN}` },
+        body: JSON.stringify(payload),
+    });
+    const data = await res.json();
+    if (!res.ok) throw new Error(`Failed to post preview: ${JSON.stringify(data)}`);
+    return data.id;
+}
+
+async function updateAnnounceDraftPreview(draft) {
+    const payload = buildAnnouncePreviewPayload(draft);
+    const res = await fetch(`https://discord.com/api/v10/channels/${ANNOUNCE_TESTING_CHANNEL_ID}/messages/${draft.testingMessageId}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bot ${TOKEN}` },
+        body: JSON.stringify(payload),
+    });
+    if (!res.ok) console.error('[BeastBot] updateAnnounceDraftPreview failed:', await res.text());
+}
+
+async function pollAnnounceDrafts() {
+    if (botFeatures.announceDrafts === false) return;
+    try {
+        const docs = await firestoreRunQuery('announceDrafts', 'status', 'pending', 5);
+        for (const doc of docs) {
+            const id = doc.name.split('/').pop();
+            if (processedAnnounceDraftIds.has(id)) continue;
+            processedAnnounceDraftIds.add(id);
+            const f = decodeFirestoreFields(doc.fields);
+            console.log(`[BeastBot] Drafting announcement ${id} (${f.source}: ${f.sourceDetail || ''})`);
+            try {
+                const { title, body } = await draftAnnouncementText({ promptText: f.promptText });
+                const draft = { ...f, id, title, bodyText: body, status: 'awaiting_approval', updatedAt: new Date().toISOString() };
+                const messageId = await postAnnounceDraftPreview(draft);
+                draft.testingMessageId = messageId;
+                await saveAnnounceDraft(id, draft);
+            } catch (e) {
+                console.error(`[BeastBot] Failed to draft announcement ${id}:`, e.message);
+                await saveAnnounceDraft(id, { ...f, id, status: 'failed', updatedAt: new Date().toISOString() });
+            }
+        }
+    } catch (e) {
+        console.error('[BeastBot] pollAnnounceDrafts error:', e.message);
+    }
+}
+
+// Simple recurring-announcement schedule. Config lives in botConfig/announceSchedule as
+// `entriesJson` — a JSON array of { id, label, dayOfWeek (0-6, Sun=0), hour (0-23, UTC),
+// promptText, targetChannelId, lastFiredKey }. No dashboard UI yet for editing this list —
+// write to that Firestore doc directly (or ask Claude to add/update entries) until one exists.
+async function checkAnnounceSchedule() {
+    if (botFeatures.announceDrafts === false) return;
+    try {
+        const cfg = await firestoreGet('botConfig', 'announceSchedule');
+        if (!cfg?.entriesJson) return;
+        let entries;
+        try { entries = JSON.parse(cfg.entriesJson); } catch (_) { return; }
+        if (!Array.isArray(entries) || !entries.length) return;
+        const now = new Date();
+        const jan1 = new Date(Date.UTC(now.getUTCFullYear(), 0, 1));
+        const week = Math.ceil((((now - jan1) / 86400000) + jan1.getUTCDay() + 1) / 7);
+        const fireKey = `${now.getUTCFullYear()}-W${week}`;
+        let changed = false;
+        for (const entry of entries) {
+            if (now.getUTCDay() !== entry.dayOfWeek || now.getUTCHours() !== entry.hour) continue;
+            if (entry.lastFiredKey === fireKey) continue;
+            const id = `ad-sched-${entry.id}-${Date.now()}`;
+            await saveAnnounceDraft(id, {
+                id, status: 'pending', source: 'schedule', sourceDetail: entry.label || entry.id,
+                promptText: entry.promptText, targetChannelId: entry.targetChannelId, requestedBy: 'schedule',
+                historyJson: '[]', createdAt: now.toISOString(), updatedAt: now.toISOString(),
+            });
+            entry.lastFiredKey = fireKey;
+            changed = true;
+            console.log(`[BeastBot] Scheduled announcement fired: ${entry.label || entry.id}`);
+        }
+        if (changed) await firestoreSet('botConfig', 'announceSchedule', { entriesJson: JSON.stringify(entries) });
+    } catch (e) {
+        console.error('[BeastBot] checkAnnounceSchedule error:', e.message);
+    }
+}
+
+function isAnnounceApprover(interaction) {
+    return interaction.user.id === OWNER_DISCORD_ID || !!interaction.member?.roles?.cache?.has(MOD_ROLE_ID);
+}
+
+async function handleAnnounceApprove(interaction) {
+    const id = interaction.customId.split(':')[1];
+    if (!isAnnounceApprover(interaction)) return interaction.reply({ content: '❌ Owner/Mod only.', flags: 64 });
+    await interaction.deferUpdate();
+    const f = await getAnnounceDraft(id);
+    if (!f) return;
+    try {
+        const payload = buildAnnouncePayload(f.title, f.bodyText);
+        const res = await fetch(`https://discord.com/api/v10/channels/${f.targetChannelId}/messages`, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json', Authorization: `Bot ${TOKEN}` },
+            body: JSON.stringify(payload),
+        });
+        const data = await res.json();
+        if (!res.ok) throw new Error(JSON.stringify(data));
+        await saveAnnounceDraft(id, { ...f, id, status: 'posted', postedMessageId: data.id, updatedAt: new Date().toISOString() });
+        const footer = { type: 17, accent_color: 0x3ba55d, components: [ { type: 10, content: `✅ **Approved & posted** to <#${f.targetChannelId}> by <@${interaction.user.id}>` } ] };
+        const preview = { type: 17, accent_color: 0x5865f2, components: [ { type: 10, content: f.title ? `## ${f.title}\n\n${f.bodyText}` : f.bodyText } ] };
+        await fetch(`https://discord.com/api/v10/channels/${ANNOUNCE_TESTING_CHANNEL_ID}/messages/${f.testingMessageId}`, {
+            method: 'PATCH',
+            headers: { 'Content-Type': 'application/json', Authorization: `Bot ${TOKEN}` },
+            body: JSON.stringify({ flags: 32768, components: [ footer, preview ] }),
+        });
+    } catch (e) {
+        console.error('[BeastBot] handleAnnounceApprove failed:', e.message);
+        await interaction.followUp({ content: `❌ Failed to post: ${e.message}`, flags: 64 });
+    }
+}
+
+async function handleAnnounceReject(interaction) {
+    const id = interaction.customId.split(':')[1];
+    if (!isAnnounceApprover(interaction)) return interaction.reply({ content: '❌ Owner/Mod only.', flags: 64 });
+    await interaction.deferUpdate();
+    const f = await getAnnounceDraft(id);
+    if (!f) return;
+    await saveAnnounceDraft(id, { ...f, id, status: 'rejected', updatedAt: new Date().toISOString() });
+    const footer = { type: 17, accent_color: 0xed4245, components: [ { type: 10, content: `🗑️ **Discarded** by <@${interaction.user.id}>` } ] };
+    const preview = { type: 17, accent_color: 0x5865f2, components: [ { type: 10, content: f.title ? `## ${f.title}\n\n${f.bodyText}` : f.bodyText } ] };
+    await fetch(`https://discord.com/api/v10/channels/${ANNOUNCE_TESTING_CHANNEL_ID}/messages/${f.testingMessageId}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bot ${TOKEN}` },
+        body: JSON.stringify({ flags: 32768, components: [ footer, preview ] }),
+    });
+}
+
+async function handleAnnounceEditButton(interaction) {
+    const id = interaction.customId.split(':')[1];
+    if (!isAnnounceApprover(interaction)) return interaction.reply({ content: '❌ Owner/Mod only.', flags: 64 });
+    const modal = new ModalBuilder().setCustomId(`annedit_modal:${id}`).setTitle('Request changes');
+    const input = new TextInputBuilder()
+        .setCustomId('changes')
+        .setLabel('What should change?')
+        .setStyle(TextInputStyle.Paragraph)
+        .setPlaceholder('e.g. "make it shorter and mention the 20% discount code BEAST20"')
+        .setRequired(true)
+        .setMaxLength(1000);
+    modal.addComponents(new ActionRowBuilder().addComponents(input));
+    await interaction.showModal(modal);
+}
+
+async function handleAnnounceEditModal(interaction) {
+    const id = interaction.customId.split(':')[1];
+    if (!isAnnounceApprover(interaction)) return interaction.reply({ content: '❌ Owner/Mod only.', flags: 64 });
+    await interaction.deferReply({ flags: 64 });
+    const changeRequest = interaction.fields.getTextInputValue('changes');
+    const f = await getAnnounceDraft(id);
+    if (!f) return interaction.editReply({ content: '❌ Draft not found (may have expired).' });
+    try {
+        const { title, body } = await draftAnnouncementText({ priorTitle: f.title, priorBody: f.bodyText, changeRequest });
+        let history = [];
+        try { history = JSON.parse(f.historyJson || '[]'); } catch (_) {}
+        history.push({ role: 'request', text: changeRequest, ts: Date.now(), by: interaction.user.tag });
+        const updated = { ...f, id, title, bodyText: body, historyJson: JSON.stringify(history).slice(0, 100000), updatedAt: new Date().toISOString() };
+        await saveAnnounceDraft(id, updated);
+        await updateAnnounceDraftPreview(updated);
+        await interaction.editReply({ content: '✅ Updated the draft above.' });
+    } catch (e) {
+        console.error('[BeastBot] handleAnnounceEditModal failed:', e.message);
+        await interaction.editReply({ content: `❌ Failed to regenerate: ${e.message}` });
+    }
+}
